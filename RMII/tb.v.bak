`timescale 1ns / 1ps

module tb_compression();

    // Inputs
    reg        clk;
    reg        rst_n;
    
    // Port A inputs
    reg        phya_rx_crs_dv;
    reg  [1:0] phya_rxd;
    
    // Port B inputs (for testing the other direction too if needed)
    reg        phyb_rx_crs_dv;
    reg  [1:0] phyb_rxd;

    // Outputs
    wire       phya_tx_en;
    wire [1:0] phya_txd;
    wire       phyb_tx_en;
    wire [1:0] phyb_txd;

    // Instantiate the Unit Under Test (UUT)
    compression uut (
        .clk            (clk),
        .rst_n          (rst_n),
        .phya_rx_crs_dv (phya_rx_crs_dv),
        .phya_rxd       (phya_rxd),
        .phya_tx_en     (phya_tx_en),
        .phya_txd       (phya_txd),
        .phyb_rx_crs_dv (phyb_rx_crs_dv),
        .phyb_rxd       (phyb_rxd),
        .phyb_tx_en     (phyb_tx_en),
        .phyb_txd       (phyb_txd)
    );

    // 50MHz Clock Generation (20ns period)
    always #10 clk = ~clk;

    initial begin
        // Initialize signals
        clk            = 1'b0;
        rst_n          = 1'b0;
        phya_rx_crs_dv = 1'b0;
        phya_rxd       = 2'b00;
        phyb_rx_crs_dv = 1'b0;
        phyb_rxd       = 2'b00;

        // Apply reset for 40ns
        #40;
        rst_n = 1'b1;
        #20;

        // --- TEST: Send a byte from Port A to Port B ---
        // Let's send the byte 8'hA5 (Binary: 10 10 01 01)
        // In RMII, bits are sent LSB first: 
        // 1st clock: 2'b01
        // 2nd clock: 2'b01
        // 3rd clock: 2'b10
        // 4th clock: 2'b10
        
        $display("Starting packet transmission from Port A to Port B...");
        
        phya_rx_crs_dv = 1'b1; // Turn on carrier sense (packet starts)
        
        phya_rxd = 2'b01; #20; // Bits [1:0]
        phya_rxd = 2'b01; #20; // Bits [3:2]
        phya_rxd = 2'b10; #20; // Bits [5:4]
        phya_rxd = 2'b10; #20; // Bits [7:6]

        // Keep transmitting some dummy data or hold for a few clocks
        phya_rxd = 2'b11; #20;
        phya_rxd = 2'b00; #20;

        // End of packet
        phya_rx_crs_dv = 1'b0; 
        phya_rxd       = 2'b00;
        
        #100;
        $display("Test finished!");
        $finish;
    end

endmodule