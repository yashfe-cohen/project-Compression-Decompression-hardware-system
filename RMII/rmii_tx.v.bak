module rmii_tx (
    input            clk,      
    input            rst_n,    
    input            start,    // start transmission
    input      [7:0] din,      // data in 8 bit
    input            end_pkt,  // end packet
    output reg       req,      // request new byte
    output reg       tx_en,    
    output reg [1:0] txd       // data out 2 bit
);

    localparam S_IDLE = 1'b0;  // Waiting for start
    localparam S_TX   = 1'b1;  // Transmitting data

    reg       st;              // current state
    reg [1:0] cnt;             // counter for 8 bit
    reg [7:0] shreg;           // register hold outgoing bits

    always @(posedge clk or negedge rst_n) begin
        if (rst_n == 1'b0) begin
            // Reset all 
            st    <= S_IDLE;
            req   <= 1'b0;
            tx_en <= 1'b0;
            txd   <= 2'd0;
            cnt   <= 2'd0;
            shreg <= 8'd0;
        end else begin
            req <= 1'b0; // default clear

            case (st)
                S_IDLE: begin
                    tx_en <= 1'b0;
                    txd   <= 2'd0;
                    cnt   <= 2'd0;
                    
                    if (start == 1'b1) begin
                        st    <= S_TX;       // move to TX
                        tx_en <= 1'b1;       // enable PHY
                        shreg <= din;        // load first byte
                        txd   <= din[1:0];   // output first 2 bits
                        cnt   <= 2'd1;       // next step will be 1
                    end
                end

                S_TX: begin
                    if (cnt == 2'd0) begin
                        if (end_pkt == 1'b1) begin
                            st    <= S_IDLE; // end of packet
                            tx_en <= 1'b0; 
                            txd   <= 2'd0;
                        end else begin
                            // load new byte
                            shreg <= din;
                            txd   <= din[1:0]; 
                            cnt   <= cnt + 1'b1;
                        end
                    end else begin
                        // shift out 2 bits
                        txd   <= shreg[3:2];
                        shreg <= {2'b00, shreg[7:2]};
                        cnt   <= cnt + 1'b1;

                        // 8 bits transmit
                        if (cnt == 2'd3) begin
                            req <= 1'b1;     // request next byte
                        end
                    end
                end

                default: st <= S_IDLE;
            endcase
        end
    end

endmodule