module rmii_rx (
    input            clk,      
    input            rst_n,    
    input            crs_dv,   // data valid from PHY
    input      [1:0] rxd,      // data in 
    output reg [7:0] dout,     // output data 8 bit
    output reg       valid     // high when dout is valid 
);

    // FSM States
    localparam S_IDLE = 2'd0;  // 
    localparam S_SFD  = 2'd1;  // (11)
    localparam S_RX   = 2'd2;  // Receiving data

    reg [1:0] st;              // current state
    reg [1:0] cnt;             // counter for 8 bit 
    reg [7:0] shreg;           // register hold incoming bits

    always @(posedge clk or negedge rst_n) begin
        if (rst_n == 1'b0) begin
            // Reset all 
            st    <= S_IDLE;
            dout  <= 8'd0;
            valid <= 1'b0;
            cnt   <= 2'd0;
            shreg <= 8'd0;
        end else begin
            valid <= 1'b0; // default clear

            case (st)
                S_IDLE: begin
                    cnt <= 2'd0; // reset counter
                    if (crs_dv == 1'b1) begin
                        st <= S_SFD; // data detected
                    end
                end

                S_SFD: begin
                    if (crs_dv == 1'b0) begin
                        st <= S_IDLE; // crs_dv dropped
                    end else if (rxd == 2'b11) begin
                        st  <= S_RX;  // SFD detected
                        cnt <= 2'd0; 
                    end
                end

                S_RX: begin
                    if (crs_dv == 1'b0) begin
                        st <= S_IDLE; // end of packet
                    end else begin
                        // shift new 2 bits
                        shreg <= {rxd, shreg[7:2]};
                        cnt   <= cnt + 1'b1;

                        // When 8 bits collected
                        if (cnt == 2'd3) begin
                            dout  <= {rxd, shreg[7:2]}; // byte
                            valid <= 1'b1;              // data is ready
                        end
                    end
                end

                default: st <= S_IDLE;
            endcase
        end
    end

endmodule