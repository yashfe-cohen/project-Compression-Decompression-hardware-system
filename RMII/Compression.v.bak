module compression (
    input        clk,          
    input        rst_n,        // Active-low reset
    
    // --- RJ45 Port A ---
    input        phya_rx_crs_dv, // Port A receive data valid
    input  [1:0] phya_rxd,       // Port A receive data (2-bit)
    output       phya_tx_en,     // Port A transmit enable
    output [1:0] phya_txd,       // Port A transmit data (2-bit)
    
    // --- RJ45 Port B ---
    input        phyb_rx_crs_dv, // Port B receive data valid
    input  [1:0] phyb_rxd,       // Port B receive data (2-bit)
    output       phyb_tx_en,     // Port B transmit enable
    output [1:0] phyb_txd        // Port B transmit data (2-bit)
);

    // --- Wires for Direction 1: Port A -> Port B ---
    wire [7:0] a_to_b_data;
    wire       a_to_b_valid;

    // --- Wires for Direction 2: Port B -> Port A ---
    wire [7:0] b_to_a_data;
    wire       b_to_a_valid;

    // ==========================================
    // DIRECTION 1: Port A (RX) ---> Port B (TX)
    // ==========================================
    
    rmii_rx rx_from_a (
        .clk    (clk),
        .rst_n  (rst_n),
        .crs_dv (phya_rx_crs_dv),
        .rxd    (phya_rxd),
        .dout   (a_to_b_data),
        .valid  (a_to_b_valid)
    );

    rmii_tx tx_to_b (
        .clk      (clk),
        .rst_n    (rst_n),
        .valid_in (a_to_b_valid),
        .din      (a_to_b_data),
        .end_pkt  (~phya_rx_crs_dv),
        .tx_en    (phyb_tx_en),
        .txd      (phyb_txd)
    );

    // ==========================================
    // DIRECTION 2: Port B (RX) ---> Port A (TX)
    // ==========================================
    
    rmii_rx rx_from_b (
        .clk    (clk),
        .rst_n  (rst_n),
        .crs_dv (phyb_rx_crs_dv),
        .rxd    (phyb_rxd),
        .dout   (b_to_a_data),
        .valid  (b_to_a_valid)
    );

    rmii_tx tx_to_a (
        .clk      (clk),
        .rst_n    (rst_n),
        .valid_in (b_to_a_valid),
        .din      (b_to_a_data),
        .end_pkt  (~phyb_rx_crs_dv),
        .tx_en    (phya_tx_en),
        .txd      (phya_txd)
    );

endmodule